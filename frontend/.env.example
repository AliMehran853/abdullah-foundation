# ============================================================
# Frontend environment (optional)
# ============================================================
# In development this is NOT needed: Vite proxies /api to the
# backend automatically (see vite.config.js -> server.proxy).
#
# Only set this for production when the frontend is served from a
# DIFFERENT origin than the API, for example:
#
#   VITE_API_BASE_URL=https://api.abdullahfoundation.org
#
# Never put Razorpay SECRET keys here - only the public key_id,
# which is delivered to the browser by the backend, not committed.
VITE_API_BASE_URL=