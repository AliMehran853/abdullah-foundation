# ============================================================
# Abdullah Foundation Backend - Environment Variables
# ============================================================
# RENAME this file to ".env" and fill in YOUR real values.
# The ".env" file is gitignored and will NEVER be pushed to GitHub.

# ------------------------------------------------------------
# Razorpay API credentials (required)
# Get them from razorpay.com dashboard:
#   Dashboard -> Settings -> API Keys  (use "Test Mode" keys first)
# ------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ------------------------------------------------------------
# Razorpay Webhook secret (required for webhook verification)
# Set in Razorpay dashboard:
#   Dashboard -> Settings -> Webhooks -> Add/Edit webhook
#   URL: https://your-domain.com/api/webhooks/razorpay
#   Events: payment.authorized, payment.failed
#   Secret: the value you put below
# ------------------------------------------------------------
RAZORPAY_WEBHOOK_SECRET=

# ------------------------------------------------------------
# Server
# ------------------------------------------------------------
PORT=5000
NODE_ENV=development

# ------------------------------------------------------------
# Allowed frontend origin for CORS (comma separated)
# In dev, Vite proxies /api, so requests come from the same origin.
# For production, add your real frontend domain ONLY.
# ------------------------------------------------------------
CLIENT_ORIGIN=http://localhost:5173